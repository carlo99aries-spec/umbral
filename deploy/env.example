# Umbral — deployment
#
# Copy to .env on the server and fill in. Never commit the real file.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# Public origin. Must be https:// in production or shared rating links will
# point at the wrong host.
PUBLIC_URL=https://umbral.example.com

# Host port the app binds to (loopback only).
APP_PORT=3001

# Only needed for the optional `tls` profile:
DOMAIN=umbral.example.com
ACME_EMAIL=you@example.com
