# Umbral — environment
#
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT (default): SQLite, no server needed.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# PRODUCTION / DOCKER: Postgres.
# Uncomment and use `npm run db:push:pg` instead of `npm run db:push`.
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://umbral:CHANGE_ME@localhost:5432/umbral?schema=public"

# Public base URL, used to build interaction links. Must be the real origin
# in production or the rating links people share will point at localhost.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
