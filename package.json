{
  "name": "umbral",
  "version": "0.1.0",
  "private": true,
  "description": "Umbral — open-source weighted reputation network. Every interaction is rated. Your score decides what you can access.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/carlo99aries-spec/umbral",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlo99aries-spec/umbral.git"
  },
  "keywords": [
    "social-network",
    "reputation",
    "open-source",
    "nextjs",
    "black-mirror"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:push:pg": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:pg:sync": "node scripts/sync-schema.mjs",
    "icons": "node scripts/make-icons.mjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset",
    "seed": "tsx scripts/seed.ts",
    "inspect": "tsx scripts/inspect-score.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "next": "^15.5.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.16.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
